# Local development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canecorsoancestry

# Production: Northflank Django + Supabase PostgreSQL + Cloudflare/R2
# Use config.settings.northflank on the Northflank service.
DJANGO_SETTINGS_MODULE=config.settings.northflank
# DATABASE_URL should be the Supabase session-pooler PostgreSQL URL.
DATABASE_URL=
DJANGO_DB_SCHEMA=django_app
DJANGO_DB_SSLMODE=require
DJANGO_DB_EXTRA_SCHEMAS=extensions,public
DJANGO_DB_CONN_MAX_AGE=300
# Replace this with the generated Northflank hostname after the first deploy.
DJANGO_ALLOWED_HOSTS=.code.run
# Keep the public Cloudflare site edge trusted and add the Northflank origin URL after deploy.
DJANGO_CSRF_TRUSTED_ORIGINS=https://canecorsoancestry-site-edge.aighewieghosa111.workers.dev
SITE_URL=https://canecorsoancestry-site-edge.aighewieghosa111.workers.dev

# Private Cloudflare R2 media gateway
R2_GATEWAY_URL=https://canecorsoancestry-edge.aighewieghosa111.workers.dev
MEDIA_EDGE_BASE_URL=https://canecorsoancestry-edge.aighewieghosa111.workers.dev
MEDIA_EDGE_URL_TTL=300

# Production security / logging
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
DJANGO_LOG_LEVEL=INFO

# Keep a single small Gunicorn worker on the free always-on container.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Optional member email notifications
ANCESTRY_EMAIL_NOTIFICATIONS=0
DEFAULT_FROM_EMAIL=Cane Corso Ancestry <noreply@canecorsoancestry.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=10
